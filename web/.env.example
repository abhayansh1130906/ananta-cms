# Web Public Static Site Configuration (Build Time Only)
# Must NEVER contain Supabase service role keys or database credentials
SNAPSHOT_URL=https://your-project.supabase.co/storage/v1/object/authenticated/snapshots/latest/content.json
SNAPSHOT_SIGNING_SECRET=replace_with_same_hmac_signing_secret_configured_in_admin
NEXT_PUBLIC_SITE_URL=https://your-public-site.com
ALLOW_EMPTY_SNAPSHOT=false
